{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build neural (debug)",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-g",
                "-O0",
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-fno-omit-frame-pointer",
                "${workspaceFolder}/neural_network.cpp",
                "-o",
                "${workspaceFolder}/neural"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles neural_network.cpp with debug symbols (-g -O0) for gdb."
        }
    ]
}
